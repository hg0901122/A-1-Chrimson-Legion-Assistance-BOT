# Copy this file to ".env" and fill in the values.

# --- Bot ---
# From https://discord.com/developers/applications -> your app -> Bot -> Token
DISCORD_TOKEN=

# From the "General Information" page of your application
CLIENT_ID=

# From the "OAuth2" page of your application (needed for dashboard + portal login)
CLIENT_SECRET=

# The server(s) this bot/dashboard manages, comma-separated for multiple guilds.
# Guild-specific slash command deploys are instant; global deploys take up to 1 hour.
# Example for two servers: GUILD_IDS=111111111111111111,222222222222222222
GUILD_IDS=

# Legacy single-guild variable — still read as a fallback if GUILD_IDS is empty.
GUILD_ID=

# Comma-separated Discord user IDs granted permanent "Bot Manager" access —
# beyond owner, in every configured guild, on the dashboard and in commands.
# You can add more managers later from the dashboard; this list is the
# unlosable root set (useful if you ever lock yourself out).
BOT_MANAGER_IDS=

# --- Dashboard ---
# Any long random string (used to sign session cookies).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string

# Port the dashboard web server listens on
DASHBOARD_PORT=3000

# Full URL Discord redirects back to after login. Must exactly match a
# "Redirect" configured on the OAuth2 page of your application, e.g.
# http://localhost:3000/auth/callback
DASHBOARD_URL=http://localhost:3000

# If you're behind a reverse proxy (Render, Railway, Nginx, etc.) that sets
# X-Forwarded-For, leave this as true so IP blacklisting reads the real
# visitor IP instead of the proxy's IP. Set to false only for bare local use.
TRUST_PROXY=true
