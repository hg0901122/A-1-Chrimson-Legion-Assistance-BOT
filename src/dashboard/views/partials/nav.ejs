<div class="sidebar">
  <div class="brand"><span class="dot"></span> Warden</div>

  <% if (availableGuilds && availableGuilds.length > 1) { %>
    <div class="guild-switcher">
      <select onchange="window.location.href='/switch-guild/' + this.value">
        <% availableGuilds.forEach(g => { %>
          <option value="<%= g.id %>" <%= g.id === currentGuildId ? 'selected' : '' %>><%= g.name %></option>
        <% }) %>
      </select>
    </div>
  <% } %>
  <span class="access-pill"><%= accessLevel || 'staff' %></span>

  <nav class="nav">
    <a href="/" class="<%= active === 'overview' ? 'active' : '' %>">Overview</a>
    <a href="/applications" class="<%= active === 'applications' ? 'active' : '' %>">Pending Review</a>
    <a href="/applications/log" class="<%= active === 'applications' ? 'active' : '' %>">Application Log</a>
    <% if (accessLevel === 'manager') { %>
      <a href="/applications/config" class="<%= active === 'config' ? 'active' : '' %>">Configure Applications</a>
    <% } %>
    <a href="/tickets" class="<%= active === 'tickets' ? 'active' : '' %>">Ticket Log</a>
    <a href="/blacklist" class="<%= active === 'blacklist' ? 'active' : '' %>">Blacklist</a>
    <% if (accessLevel === 'manager') { %>
      <a href="/commands" class="<%= active === 'commands' ? 'active' : '' %>">Custom Commands</a>
      <a href="/team" class="<%= active === 'team' ? 'active' : '' %>">Team &amp; Managers</a>
      <a href="/settings" class="<%= active === 'settings' ? 'active' : '' %>">Ticket Settings</a>
    <% } %>
  </nav>
  <div class="sidebar-footer">
    Guild <span class="mono"><%= currentGuildId %></span><br />
    <a href="/auth/logout">Log out</a>
  </div>
</div>
