<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Submitted — Warden</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="portal-body">
  <div class="portal-shell">
    <div class="portal-card">
      <div class="portal-icon">✅</div>
      <h1>Application submitted</h1>
      <p class="portal-text">
        Your <strong><%= appType.name %></strong> application has been received.
        This was attempt <strong>#<%= attemptNumber %></strong>.
      </p>
      <p class="portal-text">You'll get a Discord DM when it's reviewed. You can close this tab.</p>
    </div>
  </div>
</body>
</html>
